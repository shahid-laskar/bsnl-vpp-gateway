{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsnl.example.invalid/vpp/controller-api-v1.json",
  "title": "BSNL VPP controller northbound API v1 (portal subscriber events)",
  "description": "Single source of truth for the Django portal <-> VPP controller contract. The Django client (apps/network_control/clients/vpp_controller.py) must produce bodies that validate against these definitions; golden vectors live in config/contract/golden/.",
  "$defs": {
    "sessionKey": {
      "description": "TenantContext key + '/' + private IPv4 (FINAL plan section 5.3 SessionKey).",
      "type": "string", "minLength": 3, "maxLength": 512
    },
    "activateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "subscriber"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "subscriber": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_key", "tenant_key", "subscriber_id", "session_id", "private_ipv4", "valid_until"],
          "properties": {
            "session_key": {"$ref": "#/$defs/sessionKey"},
            "tenant_key": {"type": "string", "minLength": 1, "maxLength": 256},
            "subscriber_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "private_ipv4": {"type": "string", "format": "ipv4"},
            "mac": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$"},
            "valid_until": {"type": "string", "description": "RFC 3339 timestamp with offset", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
            "qos_profile_ref": {"type": ["string", "null"]},
            "policy_ref": {"type": ["string", "null"]}
          }
        }
      }
    },
    "deactivateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "session_key"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "session_key": {"$ref": "#/$defs/sessionKey"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "lifecycleResponse": {
      "type": "object",
      "required": ["contract_version", "operation_id", "idempotency_key", "gateway_revision", "changed", "authorized", "session_key", "reason", "dataplane_enforced"],
      "properties": {
        "contract_version": {"const": "v1"},
        "operation_id": {"type": "string"},
        "idempotency_key": {"type": "string"},
        "gateway_revision": {"type": "integer"},
        "changed": {"type": "boolean"},
        "authorized": {"type": "boolean"},
        "session_key": {"type": "string"},
        "reason": {"type": "string"},
        "dataplane_enforced": {"type": "boolean", "description": "true only when the subscriber state has been applied to VPP; false while the dataplane adapter is dry-run"}
      }
    }
  }
}
