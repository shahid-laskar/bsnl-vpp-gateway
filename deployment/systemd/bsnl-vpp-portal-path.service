[Unit]
Description=BSNL VPP lab path to existing captive portal
After=network-online.target bsnl-vpp-lab-links.service
Wants=network-online.target
Requires=bsnl-vpp-lab-links.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bsnl-vpp-portal-path start
ExecStop=/usr/local/sbin/bsnl-vpp-portal-path stop

[Install]
WantedBy=multi-user.target
