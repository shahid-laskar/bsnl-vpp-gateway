#!/bin/sh
set -eu

rules=/etc/bsnl-vpp/portal-path.nft

case "${1:-start}" in
  start)
    nft delete table ip bsnl_vpp_portal 2>/dev/null || true
    nft -f "$rules"
    ;;
  stop)
    nft delete table ip bsnl_vpp_portal 2>/dev/null || true
    ;;
  *)
    echo "usage: $0 [start|stop]" >&2
    exit 2
    ;;
esac
