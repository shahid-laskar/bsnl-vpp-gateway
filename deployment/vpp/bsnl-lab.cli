comment { BSNL VPP lab dataplane fixture, executed by VPP itself at start-up }
comment { via "unix { exec /etc/vpp/bsnl-lab.cli }". VPP re-applies it on every }
comment { restart, so there is no race between vpp.service and vppctl oneshots. }
comment { Requires the Linux veths from bsnl-vpp-lab-links.service to exist first. }
comment { Interim (plan Step 1): these objects move to the controller in Step 4. }

comment { af_packet attachments (was bsnl-vpp-afpacket) }
comment { Fixed MACs: without hw-addr VPP picks a random 02:fe MAC on every start, }
comment { so after a restart subscribers and the Linux host on br-wan kept the old }
comment { gateway MAC in their ARP caches and lost traffic for 30-50 s (2026-11-17). }
create host-interface name vpp-access hw-addr 02:fe:b5:00:00:01
create host-interface name vpp-wan hw-addr 02:fe:b5:00:00:02
set interface state host-vpp-access up
set interface state host-vpp-wan up

comment { L3 fixture and portal route (was bsnl-vpp-l3-forwarding) }
set interface ip address host-vpp-access 192.0.2.1/24
set interface ip address host-vpp-wan 198.51.100.1/24
ip route add 10.44.0.0/22 via 198.51.100.2 host-vpp-wan

comment { QinQ tenant circuit, outer 0x8100/200 inner 0x8100/101 (was bsnl-vpp-qinq) }
comment { D-09 candidate A (ADR-017): the tenant sits in captive VRF 101; the controller }
comment { steers authenticated sources to the internet VRF (table 0) with SVS. }
ip table add 101
create sub-interfaces host-vpp-access 101 dot1q 200 inner-dot1q 101 exact-match
set interface ip table host-vpp-access.101 101
set interface ip address host-vpp-access.101 10.9.101.1/24
set interface state host-vpp-access.101 up

comment { Captive VRF 101: portal, resolver and a default route to the gateway host, }
comment { whose nftables redirects tcp/80 to the redirector and drops the rest (ADR-015). }
comment { Attached paths via host-vpp-wan: a recursive "via 198.51.100.2 next-hop-table 0" }
comment { for 198.51.100.2/32 itself resolved to drop (pre-auth DNS lost, 2026-11-17). }
ip route add 10.44.0.209/32 table 101 via 198.51.100.2 host-vpp-wan
ip route add 198.51.100.2/32 table 101 via 198.51.100.2 host-vpp-wan
ip route add 0.0.0.0/0 table 101 via 198.51.100.2 host-vpp-wan
comment { Internet VRF (table 0) back to the tenant as an attached route: VPP's local }
comment { source check needs a real adjacency (a lookup-in-table route made ip4-receive }
comment { drop authenticated pings to 192.0.2.1). The relay address 10.9.101.1 is }
comment { looked up in VRF 101 so Kea's replies to giaddr stay local to VPP. }
ip route add 10.9.101.0/24 via host-vpp-access.101
ip route add 10.9.101.1/32 via ip4-lookup-in-table 101

comment { DHCP relay to Kea on br-wan (was bsnl-vpp-dhcp-proxy); clients are in VRF 101 }
set dhcp proxy server 198.51.100.2 src-address 198.51.100.1 rx-fib-id 101 server-fib-id 0

comment { Pre-auth allowlist (was bsnl-vpp-preauth). First ACL on a fresh VPP is index 0. }
set acl-plugin acl permit src 10.9.101.0/24 dst 10.44.0.209/32 proto 6 sport 0-65535 dport 80-80, permit src 10.9.101.0/24 dst 10.44.0.209/32 proto 6 sport 0-65535 dport 443-443, permit src 10.9.101.0/24 dst 10.44.0.209/32 proto 1, permit src 10.9.101.0/24 dst 198.51.100.2/32 proto 17 sport 0-65535 dport 53-53, permit src 10.9.101.0/24 dst 198.51.100.2/32 proto 6 sport 0-65535 dport 53-53, permit src 0.0.0.0/0 dst 255.255.255.255/32 proto 17 sport 68-68 dport 67-67
set acl-plugin interface host-vpp-access.101 input acl 0
