#!/bin/sh
# Replace the lab dnsmasq resolver with Unbound split-horizon DNS (P5-T5,
# ADR-014). Idempotent. Run as root from the repo:
#   sudo sh deployment/bin/bsnl-vpp-unbound-install
#   sudo sh deployment/bin/bsnl-vpp-unbound-install --rollback   # back to dnsmasq
# Backup of every file it replaces: /root/bsnl-unbound-install-<ts>.tgz
set -eu

repo="$(cd "$(dirname "$0")/../.." && pwd)"
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
ts=$(date +%Y%m%dT%H%M%S)
say() { printf '\n== %s\n' "$*"; }
UNBOUND_VERSION="${UNBOUND_VERSION:-1.19.2-1ubuntu3.12}"   # versions.lock.yaml

say "backup"
tar czf "/root/bsnl-unbound-install-$ts.tgz" --ignore-failed-read /etc/dnsmasq.d /etc/unbound \
  /etc/systemd/system/bsnl-vpp-controller.service /etc/systemd/system/unbound.service.d 2>/dev/null || true
echo "/root/bsnl-unbound-install-$ts.tgz"

if [ "${1:-}" = "--rollback" ]; then
  say "rollback to dnsmasq"
  systemctl disable --now unbound 2>/dev/null || true
  systemctl enable --now dnsmasq
  # The controller keeps writing /etc/unbound/bsnl harmlessly; its reloads fail
  # and are logged until the controller unit without --unbound-views-file is
  # installed (git show <previous>:deployment/systemd/bsnl-vpp-controller.service).
  dig +short +time=2 @198.51.100.2 wifi.bsnl.co.in
  exit 0
fi

say "install unbound $UNBOUND_VERSION without starting it (dnsmasq still owns :53)"
if ! dpkg-query -W -f '${Status}' unbound 2>/dev/null | grep -q 'install ok installed'; then
  printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
  chmod 0755 /usr/sbin/policy-rc.d
  trap 'rm -f /usr/sbin/policy-rc.d' EXIT
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "unbound=$UNBOUND_VERSION"
  rm -f /usr/sbin/policy-rc.d
  trap - EXIT
fi
apt-mark hold unbound >/dev/null

say "resolver config and controller-owned view directory"
install -d -o bsnl-vpp -g unbound -m 2750 /etc/unbound/bsnl
[ -f /etc/unbound/bsnl/authenticated.conf ] || {
  printf '# Generated by bsnl-vpp-controller (controller/dns_views.py). Do not edit.\nserver:\n' > /etc/unbound/bsnl/authenticated.conf
  chown bsnl-vpp:unbound /etc/unbound/bsnl/authenticated.conf
  chmod 0640 /etc/unbound/bsnl/authenticated.conf
}
install -m 0644 "$repo/deployment/resolver/unbound-bsnl-vpp-lab.conf" /etc/unbound/unbound.conf.d/bsnl-vpp-lab.conf
install -d /etc/systemd/system/unbound.service.d
install -m 0644 "$repo/deployment/systemd/unbound.service.d/10-bsnl-vpp-lab.conf" /etc/systemd/system/unbound.service.d/
unbound-checkconf /etc/unbound/unbound.conf

say "switch resolver: dnsmasq -> unbound"
systemctl daemon-reload
systemctl disable --now dnsmasq
systemctl enable unbound
systemctl restart unbound

say "controller unit (views file, unbound group)"
install -m 0644 "$repo/deployment/systemd/bsnl-vpp-controller.service" /etc/systemd/system/
systemctl daemon-reload
systemctl restart bsnl-vpp-controller
sleep 3

say "verify"
systemctl is-active unbound bsnl-vpp-controller
ls -l /run/unbound.ctl
runuser -u bsnl-vpp -g vpp -G unbound -- unbound-control status | head -3
echo "portal name from the gateway host: $(dig +short +time=2 @198.51.100.2 wifi.bsnl.co.in)"
echo "Run: sudo python3 -m controller.bypass_suite   (pre-auth DNS checks)"
